{
  "name": "nepali-date-pro-max",
  "version": "1.0.0",
  "description": "नेपाली Bikram Sambat ↔ Gregorian date library for the Nepali developer community. 1975–2099 BS range, full date+time, Devanagari, calendar grid, fiscal year, AD↔BS range conversion, 100+ date-fns-style helpers. TypeScript-first, zero deps, ESM+CJS.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "llms.txt",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "nepali",
    "nepali-date",
    "nepali-calendar",
    "bikram-sambat",
    "bikram",
    "sambat",
    "bs",
    "ad",
    "bs-to-ad",
    "ad-to-bs",
    "nepal",
    "calendar",
    "date",
    "datetime",
    "devanagari",
    "patro",
    "hamro-patro",
    "fiscal-year",
    "typescript",
    "nepali-date-pro-max"
  ],
  "author": "l3lackcurtains",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l3lackcurtains/nepali-date-pro-max.git"
  },
  "bugs": {
    "url": "https://github.com/l3lackcurtains/nepali-date-pro-max/issues"
  },
  "homepage": "https://github.com/l3lackcurtains/nepali-date-pro-max#readme",
  "engines": {
    "node": ">=14"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
